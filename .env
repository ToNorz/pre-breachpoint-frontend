# -------------------------------------------------------------
# Local Frontend Development (bun run dev without Docker)
# -------------------------------------------------------------
# Direct backend API URL for Vite dev server (default port 3000 -> 8080)
VITE_API_BASE_URL=http://localhost:8080
VITE_EVENT_SLUG=breachpoint-2026-r1

# -------------------------------------------------------------
# Docker Compose & Server Deployment Stack Settings
# (Used when deploying via docker-compose.yml or Portainer)
# -------------------------------------------------------------
# Dedicated Postgres Database Password
POSTGRES_PASSWORD=breachpoint

# Secret used to sign and verify JWT authentication tokens
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9_breachpoint_secret_32chars!

# Passwords for the 3 seeded admin accounts
# Accounts: admin@breachpoint.net, ops@breachpoint.net, control@breachpoint.net
ADMIN_1_PASSWORD=AdminPassword2026!
ADMIN_2_PASSWORD=OpsPassword2026!
ADMIN_3_PASSWORD=ControlPassword2026!

# Allowed origins for backend CORS validation (comma-separated)
# In production, add your domain/IP (e.g., https://ctf.example.com)
FRONTEND_ORIGIN=http://localhost:32081,http://localhost:3000

# Event publication window configuration
AUTO_PUBLISH=true
EVENT_HOURS=48

# Image tags for GHCR container images
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
