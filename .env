# Base URL of the BreachPoint API.
# Must match the backend's PORT, and the backend's FRONTEND_URL must list this
# app's origin or the browser will block every request at CORS.
VITE_API_BASE_URL=http://localhost:8080

# Which event this build plays. Matches the slug bun run db:seed creates.
VITE_EVENT_SLUG=breachpoint-2026-r1
